+# ---- deployment-level country preference (container environment) -------------
+# VPNGATE_COUNTRY pins the node pool to one or more countries; with a single
+# country routing is additionally locked to it (routing_mode=fixed_region), so
+# the best node *inside* that country is always chosen. Accepts ISO 3166-1
+# alpha-2 codes ("JP") or the country names shown in the panel ("日本"/"Japan"),
+# separated by commas or spaces. VPNGATE_COUNTRY_LOCK=0 keeps the scope filter
+# but leaves other countries available as a fallback. Unset = the panel decides.
+FORCED_COUNTRY_RAW = os.environ.get("VPNGATE_COUNTRY", "").strip()
+FORCED_COUNTRY_LOCK = str(os.environ.get("VPNGATE_COUNTRY_LOCK", "1")).strip().lower() not in {"0", "false", "no", "off"}
+_country_env_warned = False
+
+def country_code_from_name(name: str) -> str:
+    """Map a country name ("日本"/"Japan") to its ISO alpha-2 code.
+
+    Reads nodes.json directly instead of reusing normalize_routing_country():
+    this helper is also reached by the module-level `_init_cfg` bootstrap that
+    runs before most of the module's functions are defined.
+    """
+    target = str(name or "").strip()
+    if not target:
+        return ""
+    translated = vpn_utils.COUNTRY_TRANSLATIONS.get(target, target).casefold()
+    try:
+        rows = json.loads(NODES_FILE.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        rows = []
+    if not isinstance(rows, list):
+        return ""
+    for node in rows:
+        if not isinstance(node, dict):
+            continue
+        code = str(node.get("country_short") or "").strip().upper()
+        if not re.fullmatch(r"[A-Z]{2}", code):
+            continue
+        node_name = str(node.get("country") or "").strip()
+        if vpn_utils.COUNTRY_TRANSLATIONS.get(node_name, node_name).casefold() == translated:
+            return code
+    return ""
+
+def parse_country_env(value: Any) -> list[str]:
+    """Resolve VPNGATE_COUNTRY tokens (codes or names) into ISO alpha-2 codes."""
+    codes: list[str] = []
+    for token in re.split(r"[,\s/;]+", str(value or "").strip()):
+        if not token:
+            continue
+        upper = token.upper()
+        code = upper if re.fullmatch(r"[A-Z]{2}", upper) else country_code_from_name(token)
+        if re.fullmatch(r"[A-Z]{2}", code) and code not in codes:
+            codes.append(code)
+    return codes[:250]
+
+def apply_country_env(config: dict[str, Any]) -> bool:
+    """Force VPNGATE_COUNTRY onto a UI config; True when anything changed."""
+    global _country_env_warned
+    if not FORCED_COUNTRY_RAW:
+        return False
+    countries = parse_country_env(FORCED_COUNTRY_RAW)
+    if not countries:
+        if not _country_env_warned:
+            _country_env_warned = True
+            print(f"[配置] VPNGATE_COUNTRY={FORCED_COUNTRY_RAW!r} 无法解析为国家代码，已忽略（示例：JP 或 日本）", flush=True)
+        return False
+    changed = False
+    if normalize_discovery_countries(config.get("discovery_countries")) != countries:
+        config["discovery_countries"] = countries
+        changed = True
+    if FORCED_COUNTRY_LOCK:
+        current_mode = str(config.get("routing_mode") or "auto")
+        if len(countries) == 1:
+            if str(config.get("force_country") or "").strip().upper() != countries[0]:
+                config["force_country"] = countries[0]
+                changed = True
+            if current_mode in ("", "auto", "fixed_region") and current_mode != "fixed_region":
+                config["routing_mode"] = "fixed_region"
+                changed = True
+        elif str(config.get("force_country") or "").strip():
+            # A multi-country scope cannot be locked to one region: drop a stale
+            # lock so the app picks the best node across the whole scope.
+            config["force_country"] = ""
+            if current_mode == "fixed_region":
+                config["routing_mode"] = "auto"
+            changed = True
+    return changed
+
