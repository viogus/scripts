+    def _decode_chunked(payload: str) -> str:
+        decoded = []
+        while payload:
+            size_line, sep, rest = payload.partition("\r\n")
+            if not sep:
+                break
+            try:
+                size = int(size_line.split(";", 1)[0].strip() or "0", 16)
+            except ValueError:
+                break
+            if size <= 0 or len(rest) < size:
+                break
+            decoded.append(rest[:size])
+            payload = rest[size + 2:]
+        return "".join(decoded)
+
+    def _socks5_get(connect_host: str, url: str, timeout: float = 6.0) -> tuple[str, int] | None:
+        """经指定的本地 SOCKS5 代理 GET url，成功时返回 (响应体, 毫秒延迟)。"""
+        match = re.match(r"^http://([^/:]+)(?::(\d+))?(/.*)?$", url)
+        if not match:
+            return None
+        target_host = match.group(1)
+        target_port = int(match.group(2) or 80)
+        target_path = match.group(3) or "/"
+        proxy_user, proxy_pass = proxy_server.get_proxy_credentials()
+        # 沿用原先 curl 的默认 UA：ip.sb 会把未知 UA 301 跳转到 https
+        request = (
+            f"GET {target_path} HTTP/1.1\r\n"
+            f"Host: {target_host}\r\n"
+            "User-Agent: curl/8.22.0\r\n"
+            "Accept: */*\r\n"
+            "Connection: close\r\n\r\n"
+        ).encode("ascii", "ignore")
+
+        def recv_exact(conn: socket.socket, size: int) -> bytes:
+            buf = b""
+            while len(buf) < size:
+                chunk = conn.recv(size - len(buf))
+                if not chunk:
+                    raise OSError("代理连接提前关闭")
+                buf += chunk
+            return buf
+
+        started = time.monotonic()
+        conn = socket.create_connection((connect_host, LOCAL_PROXY_PORT), timeout=timeout)
+        try:
+            conn.settimeout(timeout)
+            if proxy_user is None and proxy_pass is None:
+                conn.sendall(b"\x05\x01\x00")
+            else:
+                conn.sendall(b"\x05\x02\x00\x02")
+            greeting = recv_exact(conn, 2)
+            if greeting[0] != 5 or greeting[1] == 0xFF:
+                return None
+            if greeting[1] == 2:
+                user_bytes = (proxy_user or "").encode("utf-8")[:255]
+                pass_bytes = (proxy_pass or "").encode("utf-8")[:255]
+                conn.sendall(
+                    b"\x01" + bytes([len(user_bytes)]) + user_bytes
+                    + bytes([len(pass_bytes)]) + pass_bytes
+                )
+                if recv_exact(conn, 2)[1] != 0:
+                    return None
+            host_bytes = target_host.encode("idna")
+            conn.sendall(
+                b"\x05\x01\x00\x03" + bytes([len(host_bytes)]) + host_bytes
+                + target_port.to_bytes(2, "big")
+            )
+            reply = recv_exact(conn, 4)
+            if reply[1] != 0:
+                return None
+            if reply[3] == 1:
+                recv_exact(conn, 4)
+            elif reply[3] == 3:
+                recv_exact(conn, recv_exact(conn, 1)[0])
+            elif reply[3] == 4:
+                recv_exact(conn, 16)
+            recv_exact(conn, 2)
+
+            conn.sendall(request)
+            raw = b""
+            while len(raw) <= 65536:
+                chunk = conn.recv(65536)
+                if not chunk:
+                    break
+                raw += chunk
+            latency_ms = int((time.monotonic() - started) * 1000)
+        finally:
+            try:
+                conn.close()
+            except Exception:
+                pass
+
+        text = raw.decode("utf-8", "replace")
+        status_line = text.split("\r\n", 1)[0].split()
+        if len(status_line) < 2 or status_line[1] != "200":
+            return None
+        body = text.split("\r\n\r\n", 1)[1] if "\r\n\r\n" in text else ""
+        if "transfer-encoding: chunked" in text[:2048].lower():
+            body = _decode_chunked(body)
+        return body, latency_ms
