# syntax note: 与 docker/snell/Dockerfile 等价，但
#   1) snell 下载地址可用 SNELL_BASE_URL 覆盖（镜像站/离线验证）
#   2) entrypoint 改用 musl 静态编译（与其它变体同口径；比 glibc -static 小 ~700KB）
# 用于在"底座"维度上和 tinycore/alpine 变体做同口径对比。

ARG DEBIAN_VERSION=stable-slim
ARG ALPINE_VERSION=3.20

FROM alpine:${ALPINE_VERSION} AS entrypoint

ARG SNELL_VERSION=6.0.0rc2

RUN apk add --no-cache gcc musl-dev
COPY entrypoint.c /tmp/entrypoint.c
RUN gcc -static -s -O2 -D"SNELL_VERSION=\"${SNELL_VERSION}\"" -o /entrypoint /tmp/entrypoint.c

FROM debian:${DEBIAN_VERSION} AS builder

ARG TARGETARCH TARGETVARIANT
ARG SNELL_VERSION=6.0.0rc2
ARG SNELL_BASE_URL=https://dl.nssurge.com/snell

RUN <<'SRC'
  set -eu

  case "${SNELL_VERSION}" in
    6.*)
      case "${TARGETARCH}" in
        arm)
          echo "[snell] ERROR: Snell v6 has no official armv7l build, use v4/v5" >&2
          exit 1
          ;;
      esac
      ;;
  esac

  case "${TARGETARCH}" in
    amd64)
      SNELL_ARCH=amd64
      GNU_TRIPLET=x86_64-linux-gnu
      LD_DST=/lib64/ld-linux-x86-64.so.2
      ;;
    arm64)
      SNELL_ARCH=aarch64
      GNU_TRIPLET=aarch64-linux-gnu
      LD_DST=/lib/ld-linux-aarch64.so.1
      ;;
    arm)
      if [ "${TARGETVARIANT}" = "v7" ]; then
        SNELL_ARCH=armv7l
        GNU_TRIPLET=arm-linux-gnueabihf
        LD_DST=/lib/ld-linux-armhf.so.3
      else
        echo "Unsupported arm variant: ${TARGETVARIANT}" >&2; exit 1
      fi
      ;;
    *) echo "Unsupported arch: ${TARGETARCH}" >&2; exit 1 ;;
  esac

  apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip

  URL="${SNELL_BASE_URL}/snell-server-v${SNELL_VERSION}-linux-${SNELL_ARCH}.zip"
  echo "[snell] downloading v${SNELL_VERSION} for linux/${SNELL_ARCH}"
  curl -fsSL --retry 3 --max-time 300 -o /tmp/snell.zip "$URL"
  [ -s /tmp/snell.zip ] || { echo "[snell] download failed" >&2; exit 1; }

  unzip -q /tmp/snell.zip -d /tmp/snell

  mkdir -p /runtime/root/usr/local/bin /runtime/root/lib
  cp /tmp/snell/snell-server /runtime/root/usr/local/bin/snell-server
  chmod +x /runtime/root/usr/local/bin/snell-server

  # snell v5 的 ELF 自称 static 但运行时 dlopen glibc loader —— 必须带上 glibc
  LD_SRC="/lib/${GNU_TRIPLET}/$(basename ${LD_DST})"
  mkdir -p "/runtime/root$(dirname ${LD_DST})"
  if [ -e "$LD_SRC" ]; then
    cp -a "$LD_SRC" "/runtime/root${LD_DST}"
  else
    cp -a "$LD_DST" "/runtime/root${LD_DST}"
  fi

  LIB_DIR="/lib/${GNU_TRIPLET}"
  USR_LIB_DIR="/usr/lib/${GNU_TRIPLET}"

  for lib in \
    "${LIB_DIR}/libc.so.6" \
    "${LIB_DIR}/libm.so.6" \
    "${USR_LIB_DIR}/libstdc++.so.6" \
    "${LIB_DIR}/libgcc_s.so.1"; do
    if [ -e "$lib" ]; then
      cp -L "$lib" /runtime/root/lib/
    fi
  done

  for stub in libdl.so.2 libpthread.so.0; do
    ln -sf libc.so.6 "/runtime/root/lib/${stub}"
  done

  rm -rf /tmp/snell /tmp/snell.zip
SRC

FROM scratch

COPY --from=builder /runtime/root/ /
COPY --from=entrypoint /entrypoint /entrypoint

ENV PORT="" \
    PSK="" \
    MODE="default" \
    DNS_IP_PREFERENCE="default" \
    IPV6="off" \
    OBFS="off" \
    OBFS_HOST="" \
    CONF="/app/snell-server.conf"

ENTRYPOINT ["/entrypoint"]
